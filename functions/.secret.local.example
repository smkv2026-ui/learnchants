# Emulator-only secret values. Copy to functions/.secret.local (git-ignored).
# Production values are stored in Secret Manager via:
#   firebase functions:secrets:set GOOGLE_CLIENT_ID   (etc.)
GOOGLE_CLIENT_ID=not-needed-in-mock-mode
GOOGLE_CLIENT_SECRET=not-needed-in-mock-mode
TOKEN_ENCRYPTION_KEY=local-dev-only-encryption-key
MEDIA_TOKEN_SECRET=local-dev-only-media-secret
