# Non-secret params for Cloud Functions. Copy to functions/.env.<project-id>
# (e.g. functions/.env.my-learnchants) for deploys.
APP_URL=https://<project-id>.web.app
# true = store media on local disk (emulators only). Must be false in production.
MOCK_DRIVE=false
# Set to true once App Check is configured in the web app (VITE_APPCHECK_SITE_KEY).
ENFORCE_APP_CHECK=false
