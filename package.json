{
  "name": "learnchants",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "pnpm --filter web test",
    "test:rules": "pnpm --filter web test:rules",
    "emulators": "firebase emulators:start --project demo-learnchants",
    "emulators:persist": "mkdir -p emulator-data && firebase emulators:start --project demo-learnchants --import=./emulator-data --export-on-exit",
    "dev:emu": "pnpm --filter web dev:emu"
  }
}
