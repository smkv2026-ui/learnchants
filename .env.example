# Learn Chants has three places for configuration:
#   apps/web/.env.local            public web config        (see apps/web/.env.example)
#   functions/.env.<project-id>    non-secret function params (see functions/.env.example)
#   Secret Manager                 GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY, MEDIA_TOKEN_SECRET
#                                  (emulators read them from functions/.secret.local, see functions/.secret.local.example)
# Scripts:
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
