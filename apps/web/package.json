    "canvas-confetti": "^1.9.4",
    "firebase": "^10.14.1",
    "framer-motion": "^11.18.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
