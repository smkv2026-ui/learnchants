# Public Firebase web config (Project settings → Your apps → Web app). Safe to ship to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA v3 site key). Leave empty to disable.
VITE_APPCHECK_SITE_KEY=
# true = connect to the local Emulator Suite (auth 9099, firestore 8080, functions 5001, storage 9199)
VITE_USE_EMULATORS=false
# Google Picker (folder selection for Drive storage). Same OAuth client as the functions.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
# Google Cloud project NUMBER (Picker app id, ties picked folders to this OAuth app)
VITE_GOOGLE_APP_ID=
